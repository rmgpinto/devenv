#!/usr/bin/env bash
# Make a sibling terraform import resolve inside Worktrunk's nested worktrees.
#
# Repos such as pro-infra import '../terraform/justfile', which points at
# ~/dev/work/terraform from the primary checkout. From .worktrees/<branch> the
# same path resolves to .worktrees/terraform, so link that to the real sibling
# repository instead of rewriting the tracked justfile (a rewrite is lost on
# every rebase, stash or checkout, and can end up committed).

set -euo pipefail

SOURCE=${1:?usage: wt fix-terraform-import SOURCE_WORKTREE TARGET_WORKTREE}
TARGET=${2:?usage: wt fix-terraform-import SOURCE_WORKTREE TARGET_WORKTREE}

case "$TARGET" in
  "$SOURCE"/.worktrees/*) ;;
  *) exit 0 ;;
esac

[ -f "$SOURCE/../terraform/justfile" ] || exit 0

LINK="$SOURCE/.worktrees/terraform"
if [ -L "$LINK" ] || [ ! -e "$LINK" ]; then
  ln -sfn ../../terraform "$LINK"
fi

# Undo the justfile rewrite done by earlier versions of this script, when that
# rewrite is the only local change to the file.
JUSTFILE="$TARGET/justfile"
[ -f "$JUSTFILE" ] || exit 0
if git -C "$TARGET" diff --quiet HEAD -- justfile 2>/dev/null; then
  exit 0
fi
ORIGINAL=$(git -C "$TARGET" show HEAD:justfile 2>/dev/null) || exit 0
REWRITTEN=$(sed "s#\.\./\.\./\.\./terraform/justfile#../terraform/justfile#" "$JUSTFILE")
if [ "$ORIGINAL" = "$REWRITTEN" ]; then
  git -C "$TARGET" checkout HEAD -- justfile
fi
