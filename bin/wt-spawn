#!/usr/bin/env bash
# Non-interactive worktree spawner for the agent in a Rex task session.
#
# It prepares a worktree on a TryGhost repo, then opens a tab labelled
# <repo>-<branch> in the caller's Rex session ($REX_SESSION) with nvim in the
# worktree. The agent keeps working from its own pane; the tab is for the user.
# The Rex server is reachable from the nono sandbox.
#
# Usage:
#   wt-spawn <repo> <branch> [--from-pr]
#
#   --from-pr      <branch> is an existing PR/remote branch; base the worktree
#                  on origin's tip of it (-B resets a stale local branch).
#
# stdout: the absolute worktree path (machine-readable, for the caller).
# stderr: progress.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

DEV_WORKSPACE="${DEV_WORKSPACE:-${HOME}/dev}"
WORK_DIR="${WT_WORK_DIR:-${DEV_WORKSPACE}/work}"
ORG="${WT_ORG:-TryGhost}"

FROM_PR=0
positional=()
while [ $# -gt 0 ]; do
  case "$1" in
    --from-pr)      FROM_PR=1; shift ;;
    -h|--help)      sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)             echo "wt-spawn: unknown flag: $1" >&2; exit 2 ;;
    *)              positional+=("$1"); shift ;;
  esac
done

REPO="${positional[0]-}"
BRANCH="${positional[1]-}"
if [ -z "$REPO" ] || [ -z "$BRANCH" ]; then
  echo "usage: wt-spawn <repo> <branch> [--from-pr]" >&2
  exit 2
fi

# Fetch <branch> into origin/<branch>. origin is usually SSH, which the nono
# sandbox cannot use (no known_hosts, no 1Password agent), so fall back to
# HTTPS with gh's token. Read-only: pushing still needs the host.
fetch_origin() {
  local spec="+refs/heads/$1:refs/remotes/origin/$1"
  git -C "$REPO" fetch origin "$spec" >&2 && return
  echo "wt-spawn: fetch from origin failed, retrying over HTTPS" >&2
  git -C "$REPO" -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
    fetch "https://github.com/$ORG/$REPO.git" "$spec" >&2
}

# 1. Clone if missing or pull the default branch
mkdir -p "$WORK_DIR"
cd "$WORK_DIR"
if [ ! -d "$REPO" ]; then
  echo "wt-spawn: cloning $ORG/$REPO" >&2
  gh repo clone "$ORG/$REPO" >&2
else
  DEFAULT_BRANCH=$(git -C "$REPO" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')
  DEFAULT_BRANCH=${DEFAULT_BRANCH:-main}
  if ! { git -C "$REPO" checkout "$DEFAULT_BRANCH" >&2 && fetch_origin "$DEFAULT_BRANCH" \
         && git -C "$REPO" merge --ff-only "origin/$DEFAULT_BRANCH" >&2; }; then
    echo "wt-spawn: pull failed for $REPO (continuing)" >&2
  fi
fi

cd "$REPO"
mkdir -p .worktrees
git worktree prune

# 2. Create the worktree
WT_DIR=".worktrees/${BRANCH//\//-}"
if [ "$FROM_PR" -eq 1 ]; then
  # Always base on origin's tip; -B resets a stale local branch of the same name.
  (cd .. && fetch_origin "$BRANCH")
  git worktree add -B "$BRANCH" "$WT_DIR" "origin/$BRANCH" >&2
elif git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  EXISTING_WT=$(git worktree list --porcelain | awk -v b="refs/heads/$BRANCH" '
    /^worktree / {wt=$2}
    /^branch / && $2==b {print wt; exit}
  ')
  if [ -n "$EXISTING_WT" ]; then
    echo "wt-spawn: branch '$BRANCH' is already checked out at: $EXISTING_WT" >&2
    exit 1
  fi
  git worktree add "$WT_DIR" "$BRANCH" >&2
else
  git worktree add "$WT_DIR" -b "$BRANCH" >&2
fi

# 3. Copy git-ignored mise configs
find . \( -path './.worktrees' -o -path './.git' \) -prune -o \
  \( -name '.mise.local.toml' -o -name '.mise.*.local.toml' \) \
  -type f -print | while IFS= read -r f; do
  git check-ignore -q "$f" 2>/dev/null || continue
  target="$WT_DIR/${f#./}"
  mkdir -p "$(dirname "$target")"
  awk '
    BEGIN { in_hooks = 0 }
    /^\[hooks\][[:space:]]*$/ { in_hooks = 1; next }
    /^\[/ && !/^\[hooks\][[:space:]]*$/ { in_hooks = 0 }
    !in_hooks { print }
  ' "$f" > "$target"
done

ABS="$WORK_DIR/$REPO/$WT_DIR"

# Git worktree add bypasses Worktrunk's pre-start hooks.
"$SCRIPT_DIR/wt-fix-terraform-import" "$PWD" "$ABS"

# 4. Open the worktree's tab in the caller's Rex session, without stealing focus.
echo "$ABS"
"$SCRIPT_DIR/rex-tab" "$ABS"
echo "wt-spawn: worktree ready at $ABS" >&2
