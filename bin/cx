#!/usr/bin/env zsh
# Launch Codex inside the nono AI profile.

set -e

exec env -u GH_TOKEN -u GITHUB_TOKEN OP_ACCOUNT="${OP_ACCOUNT:-GHXJDH3PVNHG3PLWLS5RT4HOHI}" \
  NONO_AUTO_MIGRATE=1 NONO_NO_SAVE_PROMPT=1 nono run \
  --profile ai \
  --allow-cwd \
  --workdir "$PWD" -- \
    /usr/bin/env CODEX_HOME="$HOME/.config/codex" codex \
    --dangerously-bypass-approvals-and-sandbox \
    --no-daemon \
    "$@"
