#!/usr/bin/env zsh
# Launch Claude Code inside the nono AI profile.

set -e

for arg in "$@"; do
  case "$arg" in
    -c|-E|-S|-o|--version|-v|-###|\
    -arch|-isysroot|-shared|-dynamiclib|-static|-bundle|\
    -mmacosx-version-min=*|-miphoneos-version-min=*|-mios-simulator-version-min=*|\
    -Wl,*|-l*|-L*|-I*|-D*|-U*|-std=*|-O*|-g|\
    *.c|*.C|*.cc|*.cpp|*.cxx|*.m|*.mm|*.s|*.S|*.o|*.a|*.dylib|*.so|*.rlib)
      exec /usr/bin/cc "$@"
      ;;
  esac
done

if [[ -n ${REX_SESSION:-} && -n ${REX_BLOCK:-} ]]; then
  rex_window=$(rex block inspect "$REX_BLOCK" --json --autostart=false 2>/dev/null |
    jq -er '.block.window_id // empty') || rex_window=
  if [[ -n $rex_window ]]; then
    rex window rename -s "$REX_SESSION" "$rex_window" ai --autostart=false >/dev/null 2>&1 || true
  fi
fi

exec env NONO_AUTO_MIGRATE=1 NONO_NO_SAVE_PROMPT=1 nono run \
  --profile ai \
  --allow-cwd \
  --workdir "$PWD" -- \
    /usr/bin/env CLAUDE_CONFIG_DIR="$HOME/.config/claude" \
    claude --dangerously-skip-permissions "$@"
