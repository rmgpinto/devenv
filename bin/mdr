#!/usr/bin/env zsh

set -o pipefail

# Called in the background; history is cached for this mdr invocation.
ci_progress() {
  local checks run workflow past jobs history result
  checks=$(gh pr checks "$number" --repo "$repo" --required --json bucket,name,link)
  [[ -n "$checks" ]] || return 1
  jobs='[]'
  history='[]'
  for run in "${(@f)$(jq -r '[.[] | select(.bucket == "pending") | .link |
      capture("/actions/runs/(?<id>[0-9]+)")? | .id] | unique[]' <<<"$checks")}"; do
    if [[ ! -f "$progress_dir/run-$run" ]]; then
      gh api "repos/$repo/actions/runs/$run" --jq .workflow_id > "$progress_dir/run-$run" || return 1
    fi
    workflow=$(<"$progress_dir/run-$run")
    [[ "$workflow" == <-> ]] || return 1
    if [[ ! -f "$progress_dir/workflow-$workflow" ]]; then
      local samples='[]' batch
      for past in "${(@f)$(gh api "repos/$repo/actions/workflows/$workflow/runs?status=success&per_page=10" \
          | jq -r '.workflow_runs[].id')}"; do
        batch=$(gh api --paginate "repos/$repo/actions/runs/$past/jobs?per_page=100" \
          --jq '.jobs[] | select(.conclusion == "success") | {name, started_at, completed_at}') || return 1
        samples=$(jq -s '.[0] + .[1:]' <(print -r -- "$samples") <(print -r -- "$batch")) || return 1
      done
      print -r -- "$samples" > "$progress_dir/workflow-$workflow"
    fi
    batch=$(gh api --paginate "repos/$repo/actions/runs/$run/jobs?per_page=100" --jq '.jobs[] | {name, status, started_at}') || return 1
    jobs=$(jq -s '.[0] + .[1:]' <(print -r -- "$jobs") <(print -r -- "$batch")) || return 1
    history=$(jq -s 'add | unique_by(.name, .started_at)' \
      <(print -r -- "$history") "$progress_dir/workflow-$workflow") || return 1
  done
  jq -nr --argjson checks "$checks" --argjson jobs "$jobs" --argjson history "$history" '
    def epoch: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    def median: sort | length as $n |
      if $n == 0 then null else (.[(($n - 1) / 2 | floor)] + .[($n / 2 | floor)]) / 2 end;
    [$checks[] | select(.bucket == "pending") | . as $check |
      ([$jobs[] | select(.name == $check.name)] | first) as $job |
      if ($check.link | test("/actions/runs/[0-9]+") | not) then {unknown:true}
      elif $job == null or $job.status == "queued" then {queued:true}
      else ([$history[] | select(.name == $check.name and .started_at != null and .completed_at != null) |
        ((.completed_at | epoch) - (.started_at | epoch))] | median) as $median |
        if $median == null or $job.started_at == null then {unknown:true}
        else {remaining: ($median - (now - ($job.started_at | epoch)))} end end] as $pending |
    "CI \($checks | length - ($pending | length))/\($checks | length) done" +
    if any($pending[]; .queued) then " · queued"
    elif any($pending[]; .unknown) then " · ETA unavailable"
    elif any($pending[]; .remaining <= 0) then " · taking longer than usual"
    elif ($pending | length) > 0 then
      ([$pending[].remaining] | max | ceil) as $seconds |
      " · ~\($seconds / 60 | floor)m \($seconds % 60)s remaining"
    else "" end'
}

worktree=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo 'mdr: not inside a Git worktree' >&2
  exit 1
}
primary_worktree=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree / { print substr($0, 10); exit }')
if [[ -z "$primary_worktree" || "$worktree" == "$primary_worktree" ]]; then
  echo 'mdr: refusing to remove the primary worktree' >&2
  exit 1
fi

branch=$(git branch --show-current)
[[ -n "$branch" ]] || {
  echo 'mdr: the worktree has a detached HEAD' >&2
  exit 1
}

pr_fields=number,baseRefName,headRefName,state,isDraft,mergeable
pr_json=$(gh pr view --json "$pr_fields" 2>/dev/null)

# Finished PRs only need local cleanup. Do this before pushing or updating main:
# the remote branch may be gone, and neither operation is needed for removal.
if [[ -n "$pr_json" ]]; then
  [[ $(jq -r '.headRefName' <<<"$pr_json") == "$branch" ]] || {
    echo "mdr: PR does not belong to the checked-out branch $branch" >&2
    exit 1
  }
  case $(jq -r '.state' <<<"$pr_json") in
    MERGED|CLOSED)
      # Worktrunk's post-remove hook also closes the worktree's Rex tab.
      wt remove --force --yes "$worktree"
      exit $?
      ;;
  esac
fi

git push --force --set-upstream origin "$branch" || {
  echo "mdr: could not push $branch" >&2
  exit 1
}

if [[ -z "$pr_json" ]]; then
  gh pr create --base main --head "$branch" --fill || {
    echo "mdr: could not create a pull request for $branch" >&2
    exit 1
  }
  pr_json=$(gh pr view --json "$pr_fields") || {
    echo "mdr: no pull request found for $branch" >&2
    exit 1
  }
fi

# GitHub computes mergeability asynchronously after a push or a new PR.
for _ in {1..30}; do
  [[ $(jq -r '.state' <<<"$pr_json") != OPEN || $(jq -r '.mergeable' <<<"$pr_json") != UNKNOWN ]] && break
  sleep 2
  pr_json=$(gh pr view --json "$pr_fields") || exit 1
done

number=$(jq -r '.number' <<<"$pr_json")
base=$(jq -r '.baseRefName' <<<"$pr_json")
state=$(jq -r '.state' <<<"$pr_json")
is_draft=$(jq -r '.isDraft' <<<"$pr_json")
mergeable=$(jq -r '.mergeable' <<<"$pr_json")

[[ $(jq -r '.headRefName' <<<"$pr_json") == "$branch" ]] || {
  echo "mdr: PR #$number does not belong to the checked-out branch $branch" >&2
  exit 1
}
[[ "$base" == main ]] || {
  echo "mdr: PR #$number targets $base, not main" >&2
  exit 1
}
if [[ "$state" != MERGED ]]; then
  [[ "$state" == OPEN && "$is_draft" == false ]] || {
    echo "mdr: PR #$number is not an open, ready-for-review PR" >&2
    exit 1
  }
  [[ "$mergeable" == MERGEABLE ]] || {
    echo "mdr: PR #$number is not currently mergeable ($mergeable)" >&2
    exit 1
  }

  gum confirm --default --affirmative Yes --negative No \
    "You're about to squash-merge PR #$number into main, proceed?" || exit 0

  repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner') || exit 1

  # Wait until the branch policy allows the merge. A required check that hasn't
  # been reported yet only shows up as BLOCKED, so poll the merge state rather than
  # counting required checks. Give up on a failed check, a missing review, or a
  # block that outlasts the timeout with nothing pending.
  started=$SECONDS
  blocked_since=$SECONDS
  progress_dir=$(mktemp -d)
  progress_pid=
  trap '[[ -n "$progress_pid" ]] && kill "$progress_pid" 2>/dev/null; rm -rf "$progress_dir"' EXIT
  while :; do
    merge_json=$(gh pr view "$number" --repo "$repo" --json mergeStateStatus,reviewDecision) || exit 1
    merge_state=$(jq -r '.mergeStateStatus' <<<"$merge_json")
    review=$(jq -r '.reviewDecision' <<<"$merge_json")
    case "$merge_state" in
      CLEAN|UNSTABLE|HAS_HOOKS)
        break
        ;;
      BLOCKED|UNKNOWN)
        if [[ "$review" == REVIEW_REQUIRED || "$review" == CHANGES_REQUESTED ]]; then
          echo "mdr: PR #$number is blocked on review ($review); keeping the worktree and its tab" >&2
          exit 1
        fi
        buckets=$(gh pr checks "$number" --repo "$repo" --required --json bucket --jq '[.[].bucket] | join(" ")' 2>/dev/null)
        if [[ " $buckets " == *" fail "* || " $buckets " == *" cancel "* ]]; then
          echo "\nmdr: PR #$number's required checks failed; keeping the worktree and its tab" >&2
          gh pr checks "$number" --repo "$repo" --required >&2
          exit 1
        fi
        pending=${#${(M)${=buckets}:#pending}}
        if (( pending == 0 && SECONDS - blocked_since > 600 )); then
          echo "\nmdr: PR #$number is still blocked by the branch policy with no checks pending; keeping the worktree and its tab" >&2
          exit 1
        fi
        (( pending > 0 )) && blocked_since=$SECONDS
        if [[ -z "$progress_pid" ]] || ! kill -0 "$progress_pid" 2>/dev/null; then
          [[ -s "$progress_dir/next" ]] && mv "$progress_dir/next" "$progress_dir/current"
          (ci_progress || print -r -- "CI · ETA unavailable") > "$progress_dir/next" 2>/dev/null &
          progress_pid=$!
        fi
        progress="CI · $pending required checks pending"
        [[ -f "$progress_dir/current" ]] && progress=$(<"$progress_dir/current")
        printf '\r\033[Kmdr: PR #%s · %s · %ds elapsed' \
          "$number" "$progress" $(( SECONDS - started )) >&2
        sleep 10
        ;;
      *)
        echo "\nmdr: PR #$number can't be merged ($merge_state); keeping the worktree and its tab" >&2
        exit 1
        ;;
    esac
  done
  echo >&2

  if ! (cd /tmp && gh pr merge "$number" --repo "$repo" --squash --delete-branch); then
    echo "mdr: PR #$number was not merged; keeping the worktree and its tab" >&2
    exit 1
  fi

  state=$(gh pr view "$number" --repo "$repo" --json state --jq '.state') || {
    echo "mdr: could not verify PR #$number after the merge command; keeping the worktree and its tab" >&2
    exit 1
  }
  [[ "$state" == MERGED ]] || {
    echo "mdr: PR #$number is $state, likely queued or awaiting auto-merge; keeping the worktree and its tab" >&2
    exit 1
  }
fi

git -C "$primary_worktree" switch main || exit 1
git -C "$primary_worktree" pull --ff-only || exit 1

# Worktrunk's post-remove hook closes the worktree's Rex tab.
wt remove --force --yes "$worktree" || exit 1
