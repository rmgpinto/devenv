{
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '.model.display_name'",
    "padding": 0
  },
  "enabledPlugins": {
    "repo-audit@ghost-claude-marketplace": true,
    "ghost-pro@ghost-claude-marketplace": true
  },
  "extraKnownMarketplaces": {
    "ghost-claude-marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/rmgpinto/dev/work/Claude"
      }
    }
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "fastMode": true,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:catppuccin-mocha"
}
