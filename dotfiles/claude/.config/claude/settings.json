{
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '.model.display_name'",
    "padding": 0
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "fastMode": true,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/rmgpinto/dev/personal/devenv/bin/rex-tab-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${REX_BLOCK:-}\" ] || rex block rename -s \"$REX_SESSION\" \"$REX_BLOCK\" ai --autostart=false >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
