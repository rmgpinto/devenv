{
  "extends": "default",
  "meta": {
    "name": "ai",
    "version": "1.0.0",
    "description": "DevEnv AI sandbox profile"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "$HOME/.agents",
      "$HOME/.config/claude",
      "$HOME/.config/claude.lock",
      "$HOME/.config/codex",
      "$HOME/.config/mise",
      "$HOME/.config/nono",
      "$HOME/.cache/aube",
      "$HOME/.cache/node",
      "$HOME/.local/state/mise",
      "$HOME/.local/state/gcloud-ai",
      "$HOME/.local/state/linear",
      "$HOME/.local/share/mise",
      "$HOME/Library/Caches/mise",
      "$HOME/dev",
      "/tmp",
      "/private/tmp"
    ],
    "allow_file": [
      "$HOME/.claude.json"
    ],
    "read_file": [
      "$HOME/dev/AGENTS.md",
      "$HOME/.CFUserTextEncoding",
      "$HOME/.config/git/config",
      "$HOME/.config/git/ignore",
      "$HOME/.config/git/work.gitconfig",
      "$HOME/.config/git/work-commit-template",
      "$HOME/.config/gh/config.yml",
      "$HOME/.gitconfig",
      "$HOME/.kube-ai/prd-k8s-01-ai-agent.yaml",
      "$HOME/.kube-ai/stg-k8s-01-ai-agent.yaml",
      "$HOME/.kube-ai/sup-k8s-01-ai-agent.yaml"
    ],
    "read": [
      "/bin",
      "/etc",
      "/opt",
      "/usr"
    ]
  },
  "network": {
    "block": false,
    "listen_port": [
      1455
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "LOGNAME",
      "SHELL",
      "TERM",
      "LANG",
      "LC_*",
      "TMPDIR",
      "MISE_*",
      "XDG_*"
    ],
    "set_vars": {
      "SSL_CERT_FILE": "/etc/ssl/cert.pem",
      "ELASTIC_STAGING_URL": "https://elastic.ghostfoundation.org",
      "ELASTIC_BASE_URL": "https://elastic.ghost.org",
      "PROMETHEUS_STAGING_URL": "https://prometheus.ghostfoundation.org",
      "PROMETHEUS_PRODUCTION_URL": "https://prometheus.ghost.org",
      "PERCONA_STAGING_URL": "https://pmm.ghostfoundation.org",
      "PERCONA_PRODUCTION_URL": "https://pmm.ghost.org"
    }
  },
  "unsafe_macos_seatbelt_rules": [
    "(allow user-preference-read)"
  ],
  "env_credentials": {
    "op://Employee/GitHub - AI read-only expires 25-04-2027/token": "GH_TOKEN",
    "op://Employee/Elastic/username": "ELASTIC_READONLY_USER",
    "op://Employee/Elastic/production-password": "ELASTIC_READONLY_PASS",
    "op://Employee/Percona/username": "PMM_USER",
    "op://Employee/Percona/staging-password": "PMM_STAGING_PASSWORD",
    "op://Employee/Percona/production-password": "PMM_PRODUCTION_PASSWORD",
    "op://Employee/DigitalOcean/credential": "DIGITALOCEAN_CREDENTIAL",
    "op://Employee/ActivityPub - AI read-only/production": "ACTIVITYPUB_PRODUCTION_CREDENTIALS",
    "op://Employee/GCP - AI read-only/username": "GCP_AI_READ_ONLY_USERNAME",
    "op://Employee/GCP - AI read-only/password": "GCP_AI_READ_ONLY_CREDENTIALS"
  }
}
