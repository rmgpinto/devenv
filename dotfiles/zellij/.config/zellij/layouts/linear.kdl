layout {
    default_tab_template {
        pane size=2 borderless=true {
            plugin location="zjstatus"
        }
        children
    }
    tab name="linear" split_direction="vertical" focus=true {
        pane name="preview" size="50%" {
            command "zsh"
            args "-ic" "file=$(printf %s __LINEAR_DRAFT_B64__ | base64 -d); watchexec --quiet --watch \"$file\" --clear clear -- glow -s \"$HOME/.config/glow/themes/catppuccin-mocha.json\" \"$file\"; exec zsh -l"
        }
        pane split_direction="horizontal" size="50%" {
            pane name="claude" size="50%" {
                command "zsh"
                args "-ic" "file=$(printf %s __LINEAR_DRAFT_B64__ | base64 -d); cc \"Help me draft the Linear ticket in $file. Edit that file directly. Keep its hidden linear-ticket metadata intact. The user can submit it with: linear-create $file\"; exec zsh -l"
            }
            pane name="nvim" size="50%" focus=true {
                command "zsh"
                args "-ic" "file=$(printf %s __LINEAR_DRAFT_B64__ | base64 -d); nvim \"$file\"; exec zsh -l"
            }
        }
    }
}
